{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yikouqingchu-demo",
  "main": "server/index.js",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LUNA_BASE_URL": "https://xiaohondou.com/v1",
    "LUNA_MODEL": "gpt-5.6-luna"
  }
}
